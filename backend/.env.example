# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# Scraper proxy (optional but RECOMMENDED).
# Route the scraper Telethon connection through a SOCKS5 in the same
# country as the scraper account's phone. Avoids Telegram's anti-share-
# code login block (a login from a foreign IP gets refused even with the
# correct SMS code). Use one of your IPRoyal sticky sessions, or any
# residential/mobile SOCKS5.
SCRAPER_PROXY_TYPE=
SCRAPER_PROXY_HOST=
SCRAPER_PROXY_PORT=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# Google Sheets
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
GOOGLE_CREDENTIALS_FILE=credentials.json

# Monitoring interval in seconds (default: 300 = 5 minutes)
MONITOR_INTERVAL=300

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# OpenAI — required for AI-generated personalized openers (Phase 2C).
# An arm can flip from static templates to AI mode and we'll generate a
# unique opener per target at campaign-launch time. Cost is paid up front
# and is small (gpt-4o-mini is ~$0.0001 per opener). Leave blank to
# disable AI mode (UI will show a "set OPENAI_API_KEY to enable" hint).
OPENAI_API_KEY=
# Model used for opener generation. Defaults to gpt-4o-mini (cheap + fast).
# Override to "gpt-4o" or "gpt-4-turbo" for higher quality at ~30x cost.
OPENAI_MODEL=gpt-4o-mini

# Phase 3 — Engagement bot (Telegram Bot API; separate from sender accounts).
# 1) Open @BotFather on Telegram, run /newbot, copy the token here.
# 2) Add the bot to your owned group as an ADMIN with "post messages" perm.
# 3) Get the group's chat_id (bot's @userinfobot can show it; supergroups
#    look like -100xxxxxxxx) and put it below.
ENGAGEMENT_BOT_TOKEN=
ENGAGEMENT_BOT_CHAT_ID=
# Google Sheet (separate spreadsheet from the scraper data) where the VA
# writes the engagement-post queue. Columns: id, content, scheduled_at,
# type, image_url, chat_id, posted_at, status. The bot auto-creates the
# tab + headers on first run if they don't exist.
ENGAGEMENT_BOT_SHEET_ID=
ENGAGEMENT_BOT_SHEET_TAB=Posts
